<?xml version="1.0" encoding="UTF-8"?>

<Defs>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>pphhyy_ArkhanStart</defName>
    <label>Bonereaper Arkhan Start</label>
    <description>Arkhan Start.</description>
    <scenario>
      <summary>Arkhan Nagashs greatest servent has come to this rimwrold to spread Holy undeath.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>pphhyy_BoneReapers_PlayerColony</factionDef>
      </playerFaction>
      <parts>

        <!-- Config pages -->
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <customSummary>Start with one sepelire and two thetes bone reapers.</customSummary>
          <xenotypeCounts>
            <li>
              <xenotype>pphhyy_BoneReaper_Arkhan</xenotype>
              <count>1</count>
              <description>arkhan bone reaper</description>
              <requiredAtStart>true</requiredAtStart>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
            <li>
              <xenotype>pphhyy_BoneReaper_Thetes</xenotype>
              <count>2</count>
              <description>thetes bone reaper</description>
              <requiredAtStart>true</requiredAtStart>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
          </xenotypeCounts>
        </li>
        <!-- Player starting stuff spawn method-->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>
        <!-- Player starting stuff spawn method-->
        <li Class="ScenPart_Naked">
          <def>Naked</def>
          <context>PlayerStarter</context>
        </li>
        <!-- Player starting stuff -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <stuff>Steel</stuff>
          <thingDef>pphhyy_BoneReapers_ThetesSword</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <stuff>Steel</stuff>
          <thingDef>pphhyy_BoneReapers_ThetesMace</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <stuff>Steel</stuff>
          <thingDef>pphhyy_BoneReapers_ThetesSpear</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <stuff>Steel</stuff>
          <thingDef>Apparel_ArkhanArmor</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <stuff>Steel</stuff>
          <thingDef>Apparel_ArkhanHelm</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>pphhyy_BoneReapers_StaffofNagash</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <stuff>Steel</stuff>
          <thingDef>pphhyy_BoneReapers_ThetesBow</thingDef>
        </li>
        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <count>2</count>
          <animalKind>pphhyy_Scarab</animalKind>
          <bondToRandomPlayerPawnChance>1.0</bondToRandomPlayerPawnChance>
        </li>
        <!-- Scatter things near player  -->
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>StartingThing_Defined</def>
          <thingDef>pphhyy_BoneMoldSteel</thingDef>
          <count>200</count>
        </li>
        <!-- Starting research -->
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>pphhyy_BoneReaperTech</project>
        </li>
        <!-- Game start dialog -->
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>Three Bone Reapers starting anew.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

</Defs>